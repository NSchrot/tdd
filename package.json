{
  "name": "biblioteca-monorepo",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm start --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend -- --host 127.0.0.1",
    "test:backend": "npm test --prefix backend",
    "test:frontend": "npm test --prefix frontend",
    "test:e2e": "npm run test:e2e --prefix frontend",
    "build:frontend": "npm run build --prefix frontend"
  }
}
